{
 "abodes": [
  {
   "num": "01 · First Abode",
   "name": "Thiruparankundram",
   "tamil": "திருப்பரங்குன்றம்",
   "meta": "Near Madurai · rock-cut hill shrine",
   "desc": "Carved into a hillside dating to the Sangam era, this is where Murugan is said to have wed Deivanai, daughter of Indra, after his victory over Surapadman. Uniquely, the abhishekam (ritual bathing) here is performed on the Vel rather than the deity's image directly.",
   "tag": "Marriage · Victory",
   "photo": "art/photos/abode-1.jpg"
  },
  {
   "num": "02 · Second Abode",
   "name": "Tiruchendur",
   "tamil": "திருச்செந்தூர்",
   "meta": "Thoothukudi District · seashore temple",
   "desc": "The only Arupadai Veedu on the coast, facing the Bay of Bengal. This is where Murugan is believed to have destroyed the demon Surapadman, marking the triumph of good over evil — the event still re-enacted at the Skanda Sashti festival.",
   "tag": "Surasamharam · Skanda Sashti",
   "photo": "art/photos/abode-2.jpg"
  },
  {
   "num": "03 · Third Abode",
   "name": "Palani",
   "tamil": "பழனி",
   "meta": "Dindigul District · hilltop shrine",
   "desc": "Perhaps the most visited of the six. Here Murugan is worshipped as Dhandayuthapani Swamy — the ascetic who renounced a fruit contest with his brother Ganesha and walked away with only wisdom. Devotees traditionally tonsure their hair as an offering.",
   "tag": "Renunciation · Wisdom",
   "photo": "art/photos/abode-3.jpg"
  },
  {
   "num": "04 · Fourth Abode",
   "name": "Swamimalai",
   "tamil": "சுவாமிமலை",
   "meta": "Near Kumbakonam",
   "desc": "Built on a mound near the Kaveri, this is where young Murugan is said to have explained the meaning of \"Om\" to his father Shiva — becoming, in that moment, guru to his own parent. The temple honours him as Swaminatha, \"lord who is teacher.\"",
   "tag": "Knowledge · Guru",
   "photo": "art/photos/abode-4.jpg"
  },
  {
   "num": "05 · Fifth Abode",
   "name": "Thiruthani",
   "tamil": "திருத்தணி",
   "meta": "Near Chennai · hilltop shrine",
   "desc": "Set on a hill said to mark the spot where Murugan paused to cool his anger after the battle with Surapadman, and where he is believed to have married Valli, the huntress-girl who became his second consort.",
   "tag": "Valli · Peace",
   "photo": "art/photos/abode-5.jpg"
  },
  {
   "num": "06 · Sixth Abode",
   "name": "Pazhamudircholai",
   "tamil": "பழமுதிர்சோலை",
   "meta": "Near Madurai · forest hill grove",
   "desc": "A grove-set shrine on a hill above Alagar Koil, associated with the story of Valli again, and considered a place of quiet, fertile abundance — its very name means \"the grove of old, ripened fruit.\"",
   "tag": "Valli · Nature",
   "photo": "art/photos/abode-6.jpg"
  }
 ],
